{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Vite App in Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true
    },
    {
      "name": "Debug WebSocket Server",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server/wsServer.js",
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}
