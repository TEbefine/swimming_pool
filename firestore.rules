rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A Player ID (Firebase uid = lowercase wallet address) may READ its own save and its own log.
    // Nobody writes from a browser: only /api/items (firebase-admin) changes saves, after validation.
    match /players/{address} {
      allow read: if request.auth != null && request.auth.uid == address;
      allow write: if false;
      match /log/{operationId} {
        allow read: if request.auth != null && request.auth.uid == address;
        allow write: if false;
      }
    }
    // AI News NPCs: today's lines are public to read; only /api/ai-news (firebase-admin) writes them.
    // aiNewsTest = preview/dev copy. aiNewsMeta (told-URL list) falls through to the deny-all below.
    match /aiNews/{docId} {
      allow get: if true; // single-doc reads only, no listing
      allow write: if false;
    }
    match /aiNewsTest/{docId} {
      allow get: if true; // single-doc reads only, no listing
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
