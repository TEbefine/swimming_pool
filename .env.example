# Public Firebase web config (Vercel: Config, Production + Preview).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Server only; never use a VITE_ prefix. Already configured in Vercel.
FIREBASE_SERVICE_ACCOUNT=
NONCE_SECRET=
# ECO-03 server only, >=32 random bytes (openssl rand -hex 32). Production gets its OWN value at ECO-04
# activation (docs/ai/ECO-04-activation.md) and never changes it. npm run dev supplies a dev-only secret. No VITE_ prefix.
FISHING_DECK_SECRET=
# Optional exact additional origins, comma-separated. No wildcard origins.
LOGIN_ALLOWED_ORIGINS=

# ECO-04: server deployment gate. Runtime config/economy.open must ALSO be true.
# Production: on at activation (the Firestore switch is the real open/close). Changing this env requires a deployment.
ECONOMY_API=off
# Server-only stable full-window launch cutoff: npm run eco:cutoff -- YYYY-MM-DD. Never recompute per deploy.
FISHING_DECK_REDEEM_FROM_DECK_ID=
# ECONOMY_EPOCH is a code constant, not an environment variable.
