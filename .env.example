# Public Firebase web config (Vercel: Config, Production + Preview).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Server only; never use a VITE_ prefix. Already configured in Vercel.
FIREBASE_SERVICE_ACCOUNT=
NONCE_SECRET=
# ECO-03 server only. Vercel: Preview -> custom branch dev-test-id ONLY; generate >=32 random bytes.
# npm run dev supplies its own dev-only secret automatically. No VITE_ prefix; Production stays unset.
FISHING_DECK_SECRET=
# Optional exact additional origins, comma-separated. No wildcard origins.
LOGIN_ALLOWED_ORIGINS=
